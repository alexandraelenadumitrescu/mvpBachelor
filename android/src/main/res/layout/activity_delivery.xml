<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.25"
        android:text="DELIVERY"
        android:textColor="@color/color_amber"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:text="potrivire fete si trimitere email automat"
        android:textColor="@color/color_text_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/color_text_dim"
            android:textSize="12sp"
            android:text="MOD POTRIVIRE" />

        <TextView
            android:id="@+id/tvModeV1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/color_amber"
            android:text="V1 DIRECT" />

        <Switch
            android:id="@+id/switchMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:thumbTint="@color/color_amber"
            android:trackTint="@color/color_surface"
            android:checked="false" />

        <TextView
            android:id="@+id/tvModeV2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/color_text_dim"
            android:text="V2 CLUSTER" />

    </LinearLayout>

    <EditText
        android:id="@+id/etEmployeesUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@color/color_surface"
        android:fontFamily="monospace"
        android:hint="URL pagina angajati"
        android:inputType="textUri"
        android:padding="14dp"
        android:textColor="@color/color_text"
        android:textColorHint="@color/color_text_dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="monospace"
        android:text="0 fotografii selectate"
        android:textColor="@color/color_text_dim"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnPick"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:text="SELECTEAZA FOTOGRAFII"
        android:textColor="@color/color_amber"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="monospace"
        android:textColor="@color/color_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:textColor="#FF5555"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/color_amber"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSend"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/color_amber"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:text="TRIMITE FOTOGRAFII"
        android:textColor="#000000"
        android:textSize="14sp" />

</LinearLayout>
