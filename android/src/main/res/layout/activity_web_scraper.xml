<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.25"
        android:text="WEB SCRAPER"
        android:textColor="@color/color_amber"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:text="detectie riscuri in imagini web"
        android:textColor="@color/color_text_dim"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@color/color_surface"
        android:fontFamily="monospace"
        android:hint="https://..."
        android:inputType="textUri"
        android:padding="14dp"
        android:textColor="@color/color_text"
        android:textColorHint="@color/color_text_dim"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnScrape"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/color_amber"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:text="ANALIZEAZA"
        android:textColor="#000000"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:indeterminateTint="@color/color_amber"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:textColor="@color/color_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="#FF5555"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="monospace"
            android:text="TOATE"
            android:textColor="@color/color_amber"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnFilterHigh"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:fontFamily="monospace"
            android:text="HIGH"
            android:textColor="@color/color_amber"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnFilterMedium"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:fontFamily="monospace"
            android:text="MEDIUM"
            android:textColor="@color/color_amber"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnFilterLow"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:fontFamily="monospace"
            android:text="LOW"
            android:textColor="@color/color_amber"
            android:textSize="11sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

</LinearLayout>
