<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.25"
        android:text="PHOTOMATCH"
        android:textColor="@color/color_amber"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:text="autentificare"
        android:textColor="@color/color_text_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:fontFamily="monospace"
            android:textColor="@color/color_text_dim"
            android:textSize="12sp"
            android:text="IP  " />

        <EditText
            android:id="@+id/etServerIp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="monospace"
            android:hint="adresa server"
            android:inputType="textUri"
            android:padding="14dp"
            android:textColor="@color/color_text"
            android:textColorHint="@color/color_text_dim"
            android:textSize="14sp" />

    </LinearLayout>

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/color_surface"
        android:fontFamily="monospace"
        android:hint="email"
        android:inputType="textEmailAddress"
        android:padding="14dp"
        android:textColor="@color/color_text"
        android:textColorHint="@color/color_text_dim"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/color_surface"
        android:fontFamily="monospace"
        android:hint="parola"
        android:inputType="textPassword"
        android:padding="14dp"
        android:textColor="@color/color_text"
        android:textColorHint="@color/color_text_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:textColor="#FF5555"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/color_amber"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/color_amber"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:text="AUTENTIFICARE"
        android:textColor="#000000"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="monospace"
        android:text="nu ai cont? creeaza unul"
        android:textColor="@color/color_amber_dim"
        android:textSize="12sp" />

</LinearLayout>
